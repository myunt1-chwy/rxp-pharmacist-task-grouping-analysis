WITH base_tasks AS (
    SELECT
        TO_VARCHAR(USER_ID) AS USER_ID,
        TO_VARCHAR(TASK_ID) AS TASK_ID,
        PROCESS_START_TIME,
        CAST(PROCESS_START_TIME AS DATE) AS D,
        DAYNAME(CAST(PROCESS_START_TIME AS DATE)) AS DAY_OF_WEEK,
        COALESCE(NULLIF(TRIM(COH::VARCHAR), ''), '<Missing>') AS COH,
        COALESCE(NULLIF(TRIM(PETTYPE::VARCHAR), ''), '<Missing>') AS PETTYPE,
        COALESCE(NULLIF(TRIM(PARENT_PART_NUMBER::VARCHAR), ''), '<Missing>') AS PARENT_PART_NUMBER,
        COALESCE(NULLIF(TRIM(APPROVAL_CHANNEL::VARCHAR), ''), '<Missing>') AS APPROVAL_CHANNEL,
        COALESCE(NULLIF(TRIM(PRESCRIPTION_SOURCE::VARCHAR), ''), '<Missing>') AS PRESCRIPTION_SOURCE,
        IMPUTED_DWELL_IN_PROGRESS_TO_CLOSED_SECONDS AS DURATION_SECONDS,
        {{ sequence_field }} AS SEQN,
        {{ length_field }} AS BATCH_LEN,
        COALESCE(NCORRECTION_FIELDS, 0) AS NCORRECTION_FIELDS
    FROM {{ source_table }}
    WHERE USER_ID IS NOT NULL
      AND TASK_ID IS NOT NULL
      AND PROCESS_START_TIME IS NOT NULL
      AND IMPUTED_DWELL_IN_PROGRESS_TO_CLOSED_SECONDS > 0
      AND {{ sequence_field }} IS NOT NULL
      AND {{ length_field }} IS NOT NULL
      AND {{ sequence_field }} >= 1
      AND {{ length_field }} >= 1
      AND {{ sequence_field }} <= {{ length_field }}
), duration_cutoff AS (
    SELECT APPROX_PERCENTILE(DURATION_SECONDS, {{ percentile }}) AS P95_SECONDS
    FROM base_tasks
), filtered_tasks AS (
    SELECT base_tasks.*, duration_cutoff.P95_SECONDS
    FROM base_tasks
    CROSS JOIN duration_cutoff
    WHERE base_tasks.DURATION_SECONDS < duration_cutoff.P95_SECONDS
)
SELECT
    USER_ID,
    TASK_ID,
    PROCESS_START_TIME,
    D,
    DAY_OF_WEEK,
    COH,
    PETTYPE,
    PARENT_PART_NUMBER,
    APPROVAL_CHANNEL,
    PRESCRIPTION_SOURCE,
    DURATION_SECONDS,
    P95_SECONDS,
    SEQN,
    BATCH_LEN,
    IFF(BATCH_LEN > 1 AND SEQN > 1, 1, 0) AS SAME_PRECEDING,
    IFF(BATCH_LEN > 1 AND SEQN < BATCH_LEN, 1, 0) AS SAME_FOLLOWING,
    IFF(NCORRECTION_FIELDS > 0, 1, 0) AS HAS_CORRECTION
FROM filtered_tasks
ORDER BY USER_ID, D, TASK_ID
